rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Администратор определяется по email (замените при необходимости)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@gmail.com';
    }
    // Любой прошедший проверку: админ (вход по email) ИЛИ клиент,
    // подтвердивший номер по SMS (Phone Auth) — в обоих случаях есть request.auth.
    function isVerified() {
      return request.auth != null;
    }

    // Слоты занятости (ячейки по 15 минут). Читать может любой (нужно,
    // чтобы показать свободное время). Создавать — только проверенный
    // пользователь (клиент с подтверждённым по SMS номером или админ).
    match /slots/{id} {
      allow read:   if true;
      allow create: if isVerified()
                    && request.resource.data.date is string
                    && request.resource.data.min is int;
      allow update, delete: if isAdmin();
    }

    // Записи клиентов. Создать можно только после SMS-подтверждения
    // номера (request.auth != null). Читать/править/удалять — админ.
    match /bookings/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isVerified()
                    && request.resource.data.name  is string
                    && request.resource.data.date  is string
                    && request.resource.data.start is int;
    }

    // Лимит записей в день на один номер (limits/{date}_{phone}).
    // Читать может любой (предпроверка в форме), писать — проверенный
    // пользователь, удалять (снять лимит при отмене) — админ.
    match /limits/{id} {
      allow read:   if true;
      allow create, update: if isVerified()
                    && request.resource.data.date is string;
      allow delete: if isAdmin();
    }
  }
}
