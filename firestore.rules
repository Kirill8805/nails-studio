rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@gmail.com';
    }
    function isVerified() {
      return request.auth != null;
    }

    // Мастера и услуги: читают все (нужно для сайта и записи),
    // меняет только администратор в «Настройках».
    match /masters/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Слоты занятости по мастеру (slots/{date}_{masterId}_{min}).
    match /slots/{id} {
      allow read:   if true;
      allow create: if isVerified()
                    && request.resource.data.date is string
                    && request.resource.data.min is int;
      allow update, delete: if isAdmin();
    }

    // Записи. Создать можно только после SMS-подтверждения номера.
    // Читает администратор — все; клиент — только свои (по uid).
    match /bookings/{id} {
      allow read:   if isAdmin()
                    || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if isVerified()
                    && request.resource.data.name  is string
                    && request.resource.data.date  is string
                    && request.resource.data.start is int;
      allow update, delete: if isAdmin();
    }

    // Лимит записей в день на один номер.
    match /limits/{id} {
      allow read:   if true;
      allow create, update: if isVerified()
                    && request.resource.data.date is string;
      allow delete: if isAdmin();
    }
  }
}
